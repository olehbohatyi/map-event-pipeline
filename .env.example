# Copy to .env and adjust. .env is git-ignored.

# ─────────────────────────────────────────────────────────────────────────────
# Broker profile: choose ONE (optionally add `,stat` to build the Spark job)
#   kafka    → apache/kafka (KRaft, no ZooKeeper)
#   redpanda → redpandadata/redpanda + console
# ─────────────────────────────────────────────────────────────────────────────
COMPOSE_PROFILES=kafka

# PostgreSQL
POSTGRES_DB=mapevents
POSTGRES_USER=mep
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Redis (host port)
REDIS_PORT=6379

# Broker host ports (inside compose the apps use broker:9092)
KAFKA_PORT=9092
REDPANDA_PORT=19092
REDPANDA_CONSOLE_PORT=8081

# Gate HTTP (host port)
GATE_PORT=8080
# Event submissions per client (API key, or address without one) per window (0 turns the limit off; the load test does)
GATE_RATE_LIMIT_REQUESTS=600
GATE_RATE_LIMIT_WINDOW_SECONDS=60
# API keys for writes (POST events, resolve): comma-separated name:sha256-hex pairs; scripts/api-key.sh <name> makes
# one. MEP_API_KEY is the key behind the "local" entry, for curl, the map's Resolve button and the load test. Both are
# for this local stack only: anywhere else, make your own and keep the key out of the repository
GATE_API_KEYS=local:ed5a18fb8f807f996d649e379d3f35f39c543a91bdbf88c492f2ebd10d4df86c
MEP_API_KEY=local-dev-key
# false lets writes through without a key (a key that is sent is still checked)
GATE_AUTH_REQUIRED=true

# Observability (grafana/otel-lgtm): Grafana UI and the OTLP endpoints apps export to
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
# Apps started outside compose (sbt gate/run) export to localhost:4318; without the lgtm container running, set
# OTEL_SDK_DISABLED=true in that shell to keep the exporter from logging connection errors
