# Copy to .env and adjust. .env is git-ignored.

# ─────────────────────────────────────────────────────────────────────────────
# Broker profile: choose ONE (optionally add `,stat` to build the Spark job)
#   kafka    → apache/kafka (KRaft, no ZooKeeper)
#   redpanda → redpandadata/redpanda + console
# ─────────────────────────────────────────────────────────────────────────────
COMPOSE_PROFILES=kafka

# PostgreSQL
POSTGRES_DB=mapevents
POSTGRES_USER=mep
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Redis (host port)
REDIS_PORT=6379

# Broker host ports
KAFKA_PORT=9092
REDPANDA_PORT=19092

# Broker address the apps use inside compose (kafka:9092 or redpanda:19092)
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
REDPANDA_CONSOLE_PORT=8080

# Gate HTTP (host port)
GATE_PORT=8080
