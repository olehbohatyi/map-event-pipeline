# Copy to .env and adjust. .env is git-ignored.

# ─────────────────────────────────────────────────────────────────────────────
# Broker profile: choose ONE (optionally add `,stat` to build the Spark job)
#   kafka    → apache/kafka (KRaft, no ZooKeeper)
#   redpanda → redpandadata/redpanda + console
# ─────────────────────────────────────────────────────────────────────────────
COMPOSE_PROFILES=kafka

# PostgreSQL
POSTGRES_DB=mapevents
POSTGRES_USER=mep
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Redis (host port)
REDIS_PORT=6379

# Broker host ports (inside compose the apps use broker:9092)
KAFKA_PORT=9092
REDPANDA_PORT=19092
REDPANDA_CONSOLE_PORT=8081

# Gate HTTP (host port)
GATE_PORT=8080

# Observability (grafana/otel-lgtm): Grafana UI and the OTLP endpoints apps export to
GRAFANA_PORT=3000
OTLP_GRPC_PORT=4317
OTLP_HTTP_PORT=4318
# Apps started outside compose (sbt gate/run) export to localhost:4318; without the lgtm container running, set
# OTEL_SDK_DISABLED=true in that shell to keep the exporter from logging connection errors
