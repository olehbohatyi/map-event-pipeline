<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{24} - %msg%n</pattern>
    </encoder>
  </appender>
  <!-- Gatling's console summary is printed directly; this keeps Netty's debug output out of it -->
  <root level="WARN">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
