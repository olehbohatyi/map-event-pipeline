{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": ""
  },
  "permissions": {
    "allow": [
      "Bash(scripts/verify.sh*)",
      "Bash(sbt -batch *)",
      "Bash(./mill --no-server *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/scalafmt.sh",
            "timeout": 60,
            "statusMessage": "scalafmt"
          }
        ]
      }
    ]
  }
}
